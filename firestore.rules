rules_version = '2';

// Collections (see feature_project/data/remote/*RemoteDataSource.kt for the exact reads/writes):
//   projects/{projectId}                          — name, ownerUid, createdAt, defaultRoleId
//   projects/{projectId}/roles/{roleId}            — name, permissions{7 bools}, isLeader
//   projects/{projectId}/members/{userId}          — userId, roleId, roleName, permissions{7 bools}, displayName, photoUrl, joinedAt
//   inviteCodes/{code}                             — projectId, expiresAt, isActive
//   projects/{projectId}/tasks/{taskId}            — title, description, holderUid, holderDisplayName,
//                                                     status, dueDate, timesHandedOver, createdByUid,
//                                                     createdByDisplayName, createdAt, updatedAt
//   projects/{projectId}/tasks/{taskId}/handoffs/{handoffId} — projectId, fromUid, fromDisplayName,
//                                                     toUid, toDisplayName, note, status, declineReason,
//                                                     offeredAt, respondedAt
//   projects/{projectId}/events/{eventId}          — type, taskId, taskTitle, byUid, byDisplayName, at
//   users/{uid}/fcmTokens/{token}                  — token, updatedAt (owner-only, Phase 3)
//
// Known gap: createProjectWithLeader() writes projects/roles/members in one WriteBatch. Firestore
// evaluates each write in a batch against the pre-batch database state, so the project/role/member
// creation rules below can only gate on "does the project doc exist yet" (true cross-doc validation
// isn't possible without a Cloud Function using the Admin SDK). Accepted for Phase 1: a signed-in
// user can only ever do this to a projectId of their own choosing that doesn't exist yet, so the
// blast radius is limited to their own new project. Revisit if this needs closing further (rule 2).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function projectExists(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId));
    }

    function isMember(projectId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    function membership(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data;
    }

    function hasPermission(projectId, perm) {
      return isMember(projectId) && membership(projectId).permissions[perm] == true;
    }

    function roleDoc(projectId, roleId) {
      return get(/databases/$(database)/documents/projects/$(projectId)/roles/$(roleId)).data;
    }

    function hasLeaderRole(projectId) {
      // Docs created before Phase 4 have no isLeader field — fall back to the roleName only the real Leader ever holds.
      return isMember(projectId) &&
        membership(projectId).get('isLeader', membership(projectId).roleName == 'Leader') == true;
    }

    // Phase 7 leadership transfer = one batch of two member writes, each checked against the other's
    // post-batch state so a project can never end up with zero or two Leaders.
    function memberAfter(projectId, uid) {
      return getAfter(/databases/$(database)/documents/projects/$(projectId)/members/$(uid)).data;
    }

    // The current Leader promoting another member; the same batch must demote the Leader themselves.
    function isLeaderPromotion(projectId, userId) {
      return hasLeaderRole(projectId) &&
        userId != request.auth.uid &&
        resource.data.roleName != 'Leader' &&
        request.resource.data.userId == resource.data.userId &&
        exists(/databases/$(database)/documents/projects/$(projectId)/roles/$(request.resource.data.roleId)) &&
        roleDoc(projectId, request.resource.data.roleId).isLeader == true &&
        request.resource.data.roleName == roleDoc(projectId, request.resource.data.roleId).name &&
        request.resource.data.permissions == roleDoc(projectId, request.resource.data.roleId).permissions &&
        request.resource.data.isLeader == true &&
        memberAfter(projectId, request.auth.uid).isLeader == false;
    }

    // The Leader stepping down to a non-Leader role; transferToUid names who the same batch promotes.
    function isLeaderDemotion(projectId, userId) {
      return userId == request.auth.uid &&
        hasLeaderRole(projectId) &&
        request.resource.data.userId == resource.data.userId &&
        exists(/databases/$(database)/documents/projects/$(projectId)/roles/$(request.resource.data.roleId)) &&
        roleDoc(projectId, request.resource.data.roleId).isLeader == false &&
        request.resource.data.roleName == roleDoc(projectId, request.resource.data.roleId).name &&
        request.resource.data.permissions == roleDoc(projectId, request.resource.data.roleId).permissions &&
        request.resource.data.isLeader == false &&
        'transferToUid' in request.resource.data &&
        request.resource.data.transferToUid != request.auth.uid &&
        memberAfter(projectId, request.resource.data.transferToUid).isLeader == true;
    }

    // Phase 7: an archived (succeeded) project keeps its history but takes no new task or handoff writes.
    function isArchived(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.get('isArchived', false) == true;
    }

    function taskDoc(projectId, taskId) {
      return get(/databases/$(database)/documents/projects/$(projectId)/tasks/$(taskId)).data;
    }

    function fullPermissions() {
      return {
        'manageRoles': true, 'manageInviteCode': true, 'removeMembers': true,
        'deleteProject': true, 'assignTasks': true, 'editAnyTask': true, 'manageTags': true
      };
    }

    function noPermissions() {
      return {
        'manageRoles': false, 'manageInviteCode': false, 'removeMembers': false,
        'deleteProject': false, 'assignTasks': false, 'editAnyTask': false, 'manageTags': false
      };
    }

    match /projects/{projectId} {
      // get is split from list: joinProject()'s transaction reads the project doc by known ID
      // (from the invite code) before the joiner is a member — a genuine chicken-and-egg gap that
      // was never exercised with a real second account until now. Project docs hold no sensitive
      // data beyond name/ownerUid/defaultRoleId, so allowing get for any signed-in user (same trust
      // boundary already accepted for inviteCodes' allow get) closes it without a real exposure.
      // list stays member-only since nothing in the app queries projects by anything but a known ID.
      allow get: if isSignedIn();
      allow list: if isMember(projectId);
      allow create: if isSignedIn() &&
        !projectExists(projectId) &&
        request.resource.data.ownerUid == request.auth.uid;
      // Succession's archival flip — only the real Leader, only isArchived, only false -> true.
      // Every other field (including a second archival, or un-archiving) stays immutable.
      allow update: if hasLeaderRole(projectId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isArchived']) &&
        resource.data.get('isArchived', false) == false &&
        request.resource.data.isArchived == true;
      // No delete-project screen in Phase 1 (spec: create/join only) — deny until that feature exists.
      allow delete: if false;

      match /roles/{roleId} {
        // Same join-transaction gap as the project doc above: joinProject() reads the default
        // role by known ID before the joiner is a member. get loosened to any signed-in user
        // (role docs hold only name/permissions/isLeader, nothing sensitive); list (Roster/Manage
        // Roles' full role-list query) stays member-only.
        allow get: if isSignedIn();
        allow list: if isMember(projectId);
        allow create: if
          // Initial Leader + Default role pair, written by createProjectWithLeader()'s batch.
          (!projectExists(projectId) &&
            ((request.resource.data.isLeader == true && request.resource.data.permissions == fullPermissions()) ||
             (request.resource.data.isLeader == false && request.resource.data.permissions == noPermissions()))) ||
          // Manage-roles screen, on an existing project.
          (projectExists(projectId) && hasPermission(projectId, 'manageRoles') && request.resource.data.isLeader == false) ||
          // Succession's roster copy: any role shape (including custom roles Phase 1's
          // CreateRoleUseCase already allows on existing projects — a pre-existing gap this
          // surfaces, not causes), gated on the caller genuinely being Leader of the project
          // being succeeded. predecessorProjectId is rule-validation-only, not in the Role model.
          (!projectExists(projectId) &&
            'predecessorProjectId' in request.resource.data &&
            hasLeaderRole(request.resource.data.predecessorProjectId));
        allow update: if hasPermission(projectId, 'manageRoles') &&
          resource.data.isLeader == false &&
          request.resource.data.isLeader == false;
        allow delete: if hasPermission(projectId, 'manageRoles') && resource.data.isLeader == false;
      }

      match /members/{userId} {
        // Roster's direct query (membersRef(projectId).snapshots(), no collectionGroup) has a
        // concrete projectId, so isMember(projectId) is resolvable once for the whole result set.
        // get also allows your own member path even when the doc doesn't exist yet, so the join
        // transaction can check "already a member" (resource.data would error on a missing doc).
        allow get: if isMember(projectId) || request.auth.uid == userId;
        allow list: if isMember(projectId) || resource.data.userId == request.auth.uid;
        allow create: if isSignedIn() && request.resource.data.userId == userId &&
          (
            // Creator claims the Leader role for a brand-new project — only for their own uid.
            (!projectExists(projectId) && request.auth.uid == userId &&
              request.resource.data.roleName == 'Leader' &&
              request.resource.data.permissions == fullPermissions() &&
              request.resource.data.isLeader == true) ||
            // Joining an existing project via a valid invite code — only for their own uid — role/
            // permissions must match the real role doc (join_project's transaction reads the
            // project's defaultRoleId), and the referenced role must not be Leader (that's only
            // claimable on project creation).
            (projectExists(projectId) && request.auth.uid == userId &&
              exists(/databases/$(database)/documents/projects/$(projectId)/roles/$(request.resource.data.roleId)) &&
              roleDoc(projectId, request.resource.data.roleId).isLeader == false &&
              request.resource.data.roleName == roleDoc(projectId, request.resource.data.roleId).name &&
              request.resource.data.permissions == roleDoc(projectId, request.resource.data.roleId).permissions &&
              request.resource.data.isLeader == false) ||
            // Succession's roster copy: the new project's Leader (auth.uid) writes every copied
            // member doc, not just their own — the one case where request.auth.uid == userId is
            // deliberately dropped, gated on the caller genuinely being Leader of the project
            // being succeeded. Can't cross-check roleId against the copied role doc (same-batch
            // writes evaluate against pre-batch state) — accepted trust boundary, see plan §5.
            (!projectExists(projectId) &&
              'predecessorProjectId' in request.resource.data &&
              hasLeaderRole(request.resource.data.predecessorProjectId))
          );
        // Reassign-role screen: only touches roleId/roleName/permissions and the roleSetBy* stamp, never the member's identity,
        // never the Leader's own membership, and never assigns the Leader role to someone else.
        allow update: if (hasPermission(projectId, 'manageRoles') &&
          resource.data.roleName != 'Leader' &&
          request.resource.data.userId == resource.data.userId &&
          exists(/databases/$(database)/documents/projects/$(projectId)/roles/$(request.resource.data.roleId)) &&
          roleDoc(projectId, request.resource.data.roleId).isLeader == false &&
          request.resource.data.roleName == roleDoc(projectId, request.resource.data.roleId).name &&
          request.resource.data.permissions == roleDoc(projectId, request.resource.data.roleId).permissions &&
          request.resource.data.isLeader == false &&
          request.resource.data.roleSetByUid == request.auth.uid) ||
          // Leadership transfer (Phase 7) — the only way the Leader membership ever changes.
          isLeaderPromotion(projectId, userId) ||
          isLeaderDemotion(projectId, userId);
        // Remove-member roster action, or self-delete (Phase 6 delete-account leaving every non-Leader
        // project) — never the Leader either way.
        allow delete: if (hasPermission(projectId, 'removeMembers') || request.auth.uid == userId) &&
          resource.data.roleName != 'Leader';
      }

      match /tasks/{taskId} {
        allow read: if isMember(projectId);
        // Creating a task makes you its initial holder — see specs/office/phase-2-board-baton.md.
        allow create: if !isArchived(projectId) && hasPermission(projectId, 'assignTasks') &&
          request.resource.data.holderUid == request.auth.uid &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.status == 'TODO' &&
          request.resource.data.timesHandedOver == 0;
        // Only two client-driven update shapes exist: the holder marking their own task done, or a
        // handoff's toUid accepting and becoming the new holder (see acceptHandoff/markTaskDone in
        // FirestoreTaskRemoteDataSource.kt). Nothing else may change holderUid/timesHandedOver.
        allow update: if isMember(projectId) && !isArchived(projectId) && (
          (request.auth.uid == resource.data.holderUid &&
            request.resource.data.status == 'DONE' &&
            request.resource.data.holderUid == resource.data.holderUid &&
            request.resource.data.timesHandedOver == resource.data.timesHandedOver) ||
          (request.auth.uid == request.resource.data.holderUid &&
            request.auth.uid != resource.data.holderUid &&
            request.resource.data.timesHandedOver == resource.data.timesHandedOver + 1)
        ) && request.resource.data.title == resource.data.title &&
          request.resource.data.createdByUid == resource.data.createdByUid;
        // Deletion is permissioned regardless of who holds the task (approved design decision, see
        // specs/office/implementation-plan.md's task-permissions section).
        allow delete: if hasPermission(projectId, 'editAnyTask') && !isArchived(projectId);

        match /handoffs/{handoffId} {
          allow read: if isMember(projectId);
          // Only the task's current holder may offer a handoff — "handing back never needs permission".
          allow create: if isMember(projectId) && !isArchived(projectId) &&
            request.auth.uid == taskDoc(projectId, taskId).holderUid &&
            request.resource.data.fromUid == request.auth.uid &&
            request.resource.data.status == 'OFFERED' &&
            request.resource.data.projectId == projectId;
          // Only the offered toUid may accept/decline, and only while still OFFERED.
          allow update: if isMember(projectId) && !isArchived(projectId) &&
            resource.data.status == 'OFFERED' &&
            request.auth.uid == resource.data.toUid &&
            (request.resource.data.status == 'ACCEPTED' || request.resource.data.status == 'DECLINED') &&
            request.resource.data.toUid == resource.data.toUid &&
            request.resource.data.fromUid == resource.data.fromUid;
          allow delete: if false;
        }
      }

      match /events/{eventId} {
        // Phase 4's Pulse tab reads this now — member-only, matching every other project subcollection.
        allow read: if isMember(projectId);
        allow create: if isMember(projectId) &&
          request.resource.data.byUid == request.auth.uid &&
          request.resource.data.type in [
            'TASK_CREATED', 'TASK_DELETED', 'HANDOFF_OFFERED', 'HANDOFF_ACCEPTED', 'HANDOFF_DECLINED', 'TASK_MARKED_DONE'
          ];
        allow update, delete: if false;
      }
    }

    // observePendingHandoffs()'s collectionGroup("handoffs") query spans every task in a project, so
    // the nested rule's isMember(projectId)/taskDoc() checks above are unresolvable per candidate doc
    // (projectId/taskId vary) — same class of issue as the members collectionGroup fix below.
    // The fromUid branch serves the Inbox's "handoffs I offered" query (Phase 3); both branches are
    // resource.data-only, so each query is provable from its own filter.
    match /{path=**}/handoffs/{handoffId} {
      allow list: if resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid;
    }

    // observeUserProjects()'s collectionGroup("members") query spans all projects, so the nested
    // rule's isMember(projectId) above is unresolvable per candidate doc there (projectId varies)
    // — Firestore's list-query validator denies the whole request rather than run it per document.
    // Cloud Firestore ORs matching rule blocks together, so this dedicated top-level rule (checked
    // purely from resource.data, provable from the query's own whereEqualTo("userId", uid) filter)
    // is what actually authorizes that query; the nested block above still governs direct access.
    match /{path=**}/members/{userId} {
      allow list: if resource.data.userId == request.auth.uid;
    }

    match /users/{uid}/fcmTokens/{token} {
      // Push tokens are owner-only; Cloud Functions read and prune them via the Admin SDK.
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /inviteCodes/{code} {
      // Join screen looks a code up by its (unguessable) document ID before the joiner is a member.
      allow get: if isSignedIn();
      // observeActiveInviteCode()'s query and generateInviteCode()'s existing-active-code lookup both
      // filter by a projectId the caller must already know. isMember(resource.data.projectId) doesn't
      // work here the way it does for roster's members list: inviteCodes isn't nested under
      // /projects/{projectId}, so projectId is per-document data, not a path segment Firestore can
      // resolve statically for a list query — same class of issue as the members collectionGroup bug,
      // but with no resource.data-only substitute available. Same trust boundary as `get` above.
      allow list: if isSignedIn();
      allow create: if hasPermission(request.resource.data.projectId, 'manageInviteCode') &&
        request.resource.data.createdByUid == request.auth.uid;
      allow update: if hasPermission(resource.data.projectId, 'manageInviteCode');
      allow delete: if false;
    }
  }
}
